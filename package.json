{
  "name": "awplanet",
  "productName": "awplanet",
  "description": "AI-native 3D direction and scene creation studio.",
  "author": "DynamicWang",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite --host",
    "dev:https": "node scripts/serve-https.mjs",
    "phone:web": "node scripts/phone-web-tunnel.mjs",
    "build": "vite build",
    "desktop:start": "npm run build && electron .",
    "desktop:icons": "node scripts/mask-app-icon.mjs",
    "desktop:package": "npm run desktop:icons && npm run build && electron-forge package",
    "desktop:make": "npm run desktop:icons && npm run build && electron-forge make",
    "desktop:make:mac": "npm run desktop:icons && npm run build && electron-forge make --platform=darwin --arch=arm64",
    "desktop:make:windows": "npm run desktop:icons && npm run build && electron-forge make --platform=win32 --arch=x64",
    "lint": "eslint .",
    "verify:rig": "node scripts/verify-character-rig.mjs",
    "preview": "vite preview",
    "preview:https": "node scripts/serve-https.mjs preview",
    "https:cert": "node scripts/create-local-https-cert.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.117.3",
    "@react-three/fiber": "^8.17.10",
    "react": "^18.3.1",
    "react-device-detect": "^2.2.3",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.3",
    "@electron-forge/cli": "^7.8.1",
    "@electron-forge/maker-dmg": "^7.8.1",
    "@electron-forge/maker-zip": "^7.8.1",
    "electron": "^36.4.0",
    "eslint": "^9.13.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "sass": "^1.81.0",
    "vite": "^5.4.10"
  }
}
